{
  "name": "worker",
  "version": "0.0.0",
  "private": true,
  "description": "Ingestion and aggregation CLI",
  "type": "module",
  "bin": {
    "ww-worker": "./dist/cli.js"
  },
  "scripts": {
    "dev": "tsx src/cli.ts",
    "build": "tsup",
    "start": "node dist/cli.js",
    "lint": "eslint src --max-warnings=0",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --config ./vitest.config.ts"
  },
  "dependencies": {
    "@wildwindow/db": "workspace:^",
    "@wildwindow/geoprivacy": "workspace:^",
    "@wildwindow/scoring": "workspace:^",
    "@wildwindow/shared": "workspace:*",
    "commander": "^13.1.0",
    "csv-parse": "^7.0.3",
    "drizzle-orm": "^0.45.4",
    "h3-js": "^4.1.0",
    "pg": "^8.23.1",
    "pg-copy-streams": "^7.0.0",
    "yaml": "^2.7.0",
    "yauzl": "^3.4.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "@types/pg": "^8.23.1",
    "@types/pg-copy-streams": "^1.2.5",
    "@types/yauzl": "^3.4.0",
    "@wildwindow/config": "workspace:*",
    "msw": "2.7.3",
    "tsup": "^8.4.0",
    "tsx": "^4.19.3",
    "typescript": "~5.8.3",
    "vitest": "^3.0.9"
  }
}
