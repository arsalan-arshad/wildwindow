{
  "name": "mobile",
  "version": "0.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "lint": "eslint app components constants lib providers testing __tests__ --max-warnings=0",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "jest",
    "config:check": "expo config --json",
    "export:web": "expo export --platform web"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.1.1",
    "@react-native-async-storage/async-storage": "^3.1.1",
    "@react-native-community/netinfo": "11.4.1",
    "@sentry/react-native": "^8.36.0",
    "@tanstack/query-async-storage-persister": "5.108.4",
    "@tanstack/react-query": "^5.108.4",
    "@tanstack/react-query-persist-client": "5.108.4",
    "@wildwindow/geoprivacy": "workspace:^",
    "@wildwindow/scoring": "workspace:^",
    "@wildwindow/shared": "workspace:^",
    "expo": "~58.0.25",
    "expo-constants": "~58.0.16",
    "expo-file-system": "^58.0.14",
    "expo-font": "~58.0.12",
    "expo-image-manipulator": "~58.0.16",
    "expo-image-picker": "~58.0.10",
    "expo-linking": "~58.0.17",
    "expo-localization": "^58.0.5",
    "expo-location": "~58.0.22",
    "expo-router": "~58.0.31",
    "expo-sharing": "^58.0.23",
    "expo-splash-screen": "~58.0.14",
    "expo-status-bar": "~58.0.5",
    "expo-symbols": "~58.0.5",
    "expo-web-browser": "~58.0.8",
    "firebase": "^12",
    "h3-js": "^4.1.0",
    "i18next": "^27.2.9",
    "posthog-react-native": "^4.87.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-i18next": "^18.0.3",
    "react-native": "0.88.1",
    "react-native-maps": "1.29.11",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-svg": "15.12.1",
    "react-native-web": "~0.21.4",
    "react-native-worklets": "0.13.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.22.0",
    "@testing-library/react-native": "^14.1.0",
    "@types/jest": "^30.0.0",
    "@types/react": "~19.3.0",
    "eslint": "^9.22.0",
    "jest": "^30.5.2",
    "jest-expo": "~58.0.0",
    "react-test-renderer": "19.3.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.26.0"
  },
  "jest": {
    "preset": "jest-expo",
    "testMatch": [
      "**/__tests__/**/*.[jt]s?(x)",
      "**/?(*.)+(spec|test).[jt]s?(x)"
    ],
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/$1",
      "^@wildwindow/shared/client$": "<rootDir>/__mocks__/@wildwindow/shared/client.ts",
      "^expo-location$": "<rootDir>/__mocks__/expo-location.ts",
      "^expo-image-picker$": "<rootDir>/__mocks__/expo-image-picker.ts",
      "^expo-image-manipulator$": "<rootDir>/__mocks__/expo-image-manipulator.ts",
      "^expo-sharing$": "<rootDir>/__mocks__/expo-sharing.ts",
      "^expo-file-system/legacy$": "<rootDir>/__mocks__/expo-file-system-legacy.ts",
      "^react-native-maps$": "<rootDir>/__mocks__/react-native-maps.tsx",
      "^@sentry/react-native$": "<rootDir>/__mocks__/@sentry/react-native.ts",
      "^posthog-react-native$": "<rootDir>/__mocks__/posthog-react-native.ts",
      "^@wildwindow/shared/analytics$": "<rootDir>/../../packages/shared/src/analytics.ts",
      "^@wildwindow/shared/sentry-scrub$": "<rootDir>/../../packages/shared/src/sentry-scrub.ts"
    },
    "transformIgnorePatterns": [
      "node_modules/(?!((jest-)?react-native|@react-native(-community)?|@react-native-async-storage/async-storage)|expo(nent)?|@expo(nent)?/.*|@expo-google-fonts/.*|react-navigation|@react-navigation/.*|@sentry/react-native|posthog-react-native|native-base|react-native-svg|react-native-maps|@tanstack/.*|i18next|react-i18next|h3-js|suncalc|firebase|@firebase/.*|zod|@wildwindow/geoprivacy|@wildwindow/scoring|@wildwindow/shared)"
    ],
    "setupFiles": [
      "<rootDir>/testing/jest-setup.ts"
    ]
  },
  "type": "module"
}
