dist/
build/
.turbo/
.next/
out/
.expo/
expo-env.d.ts
*.tsbuildinfo

# AWS CDK
**/cdk.out/
cdk.context.json

# Env and secrets
.env
.env.*
!.env.example
*.pem
service-account*.json
*-firebase-adminsdk*.json

# Vercel CLI local link (org/project ids may be force-added later per docs/VERCEL.md)
.vercel/

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json

# Test / coverage
coverage/
.nyc_output/

