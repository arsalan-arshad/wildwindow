{
  "name": "@wildwindow/geoprivacy",
  "version": "0.1.0",
  "private": true,
  "description": "Location protection for wildlife data — No-Pin Promise helpers (MIT)",
  "license": "MIT",
  "type": "module",
  "author": "WildWindow contributors",
  "keywords": [
    "h3",
    "geoprivacy",
    "wildlife",
    "privacy",
    "location",
    "conservation",
    "obscuration",
    "no-pin"
  ],
  "homepage": "https://github.com/arsalan-arshad/wildwindow/tree/main/packages/geoprivacy",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/arsalan-arshad/wildwindow.git",
    "directory": "packages/geoprivacy"
  },
  "bugs": {
    "url": "https://github.com/arsalan-arshad/wildwindow/issues"
  },
  "engines": {
    "node": ">=18"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "lint": "eslint src --max-warnings=0",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --config ./vitest.config.ts",
    "prepublishOnly": "pnpm run build && pnpm run test"
  },
  "dependencies": {
    "h3-js": "^4.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "@wildwindow/config": "workspace:*",
    "fast-check": "^4.0.0",
    "tsup": "^8.4.0",
    "typescript": "~5.8.3",
    "vitest": "^3.0.9"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  }
}
