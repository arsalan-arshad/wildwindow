{
  "name": "@wildwindow/config",
  "version": "0.0.0",
  "private": true,
  "description": "Shared tsconfig, ESLint and Prettier presets",
  "type": "module",
  "exports": {
    "./tsconfig.base.json": "./tsconfig.base.json",
    "./eslint": "./eslint/index.js",
    "./prettier": "./prettier/index.js"
  },
  "scripts": {
    "lint": "eslint --config ./eslint/index.js ./test-fixture.ts ./identity.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --config ./vitest.config.ts"
  },
  "devDependencies": {
    "@eslint/js": "^9.22.0",
    "eslint": "^9.22.0",
    "eslint-plugin-import-x": "^4.6.1",
    "globals": "^16.0.0",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.26.0",
    "vitest": "^3.0.9"
  }
}
