{
  "name": "@wildwindow/shared",
  "version": "0.0.0",
  "private": true,
  "description": "Zod API schemas, types, typed client, env helper",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./env": {
      "types": "./dist/env.d.ts",
      "import": "./dist/env.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "lint": "eslint src --max-warnings=0",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --config ./vitest.config.ts",
    "validate-data": "tsx scripts/validate-data.ts",
    "resolve-taxa": "tsx scripts/resolve-taxa.ts"
  },
  "dependencies": {
    "yaml": "^2.7.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "@wildwindow/config": "workspace:*",
    "tsup": "^8.4.0",
    "typescript": "~5.8.3",
    "vitest": "^3.0.9",
    "tsx": "^4.19.3"
  }
}
