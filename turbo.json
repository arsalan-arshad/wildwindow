{
  "$schema": "https://turbo.build/schema.json",
  "globalPassThroughEnv": [
    "CI",
    "DATABASE_URL",
    "DATABASE_URL_API",
    "DATABASE_URL_WORKER",
    "WW_API_DB_PASSWORD",
    "WW_WORKER_DB_PASSWORD",
    "OBSERVER_HASH_SALT",
    "NODE_ENV"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": ["^build"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"],
      "passThroughEnv": [
        "DATABASE_URL",
        "DATABASE_URL_API",
        "DATABASE_URL_WORKER",
        "WW_API_DB_PASSWORD",
        "WW_WORKER_DB_PASSWORD",
        "OBSERVER_HASH_SALT"
      ]
    }
  }
}
