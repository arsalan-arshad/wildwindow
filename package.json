{
  "name": "wildwindow",
  "private": true,
  "version": "0.0.0",
  "description": "WildWindow \u2014 wildlife photo forecast app (working name)",
  "type": "module",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:coverage": "vitest run --coverage",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "worker": "pnpm --filter worker exec tsx src/cli.ts",
    "data:validate": "pnpm --filter @wildwindow/shared validate-data",
    "db:up": "docker compose up -d --wait db",
    "db:down": "docker compose down",
    "db:migrate": "pnpm --filter @wildwindow/shared build && pnpm --filter @wildwindow/db migrate"
  },
  "devDependencies": {
    "@eslint/js": "^9.22.0",
    "@types/node": "^22.13.10",
    "@typescript-eslint/eslint-plugin": "^8.26.0",
    "@typescript-eslint/parser": "^8.26.0",
    "@vitest/coverage-v8": "^3.0.9",
    "@wildwindow/config": "workspace:*",
    "eslint": "^9.22.0",
    "eslint-plugin-import-x": "^4.6.1",
    "globals": "^16.0.0",
    "prettier": "^3.10.1",
    "turbo": "^2.5.4",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.26.0",
    "vitest": "^3.0.9"
  },
  "pnpm": {
    "overrides": {
      "react": "19.3.0",
      "react-dom": "19.3.0"
    }
  }
}
