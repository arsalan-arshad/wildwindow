# WildWindow environment keys (no secret values). Full list from AGENTS.md §3.
#
# Railway (preferred cloud DB/host before Milestone H): see docs/RAILWAY.md
# for the click-path and a per-service checklist (which keys go on api / web /
# worker / migrate; secret vs public). Paste values only in Railway Variables.
#
# Local DB: `pnpm db:up` starts Docker PostGIS 18-3.7 on localhost:5432
# (ARCHITECTURE §2). Example connection string after compose is up:
#   DATABASE_URL=postgresql://postgres:postgres@localhost:5432/wildwindow
# If Postgres.app (or another server) already owns 5432, stop it first or
# change the host port mapping in docker-compose.yml (e.g. "5433:5432") and
# use that port here. Host Postgres without PostGIS is not a substitute.
# PG 18 volume path is /var/lib/postgresql — after upgrading from 17-3.5,
# remove the old named volume and re-run db:up / db:migrate / db:seed.

NODE_ENV=
# Owner / migrations role (local: postgresql://postgres:postgres@localhost:5432/wildwindow)
DATABASE_URL=
# App and worker role URLs (created by `pnpm db:migrate` when passwords below are set)
DATABASE_URL_API=
DATABASE_URL_WORKER=
# Passwords for ww_api / ww_worker (ARCHITECTURE §6.3). Required to apply roles on migrate.
WW_API_DB_PASSWORD=
WW_WORKER_DB_PASSWORD=

GBIF_USER=
GBIF_PASSWORD=
GBIF_EMAIL=
GBIF_ENABLED=
INAT_DIRECT_ENABLED=
EBIRD_ENABLED=
EBIRD_PERMISSION_REF=

WEATHER_PROVIDER=
WEATHER_USER_AGENT=
TIDE_PROVIDER=

OBSERVER_HASH_SALT=
LOGBOOK_ENC_KEY=

FIREBASE_PROJECT_ID=
FIREBASE_SERVICE_ACCOUNT_JSON=

STORAGE_DRIVER=
S3_BUCKET=
S3_REGION=
LOCAL_STORAGE_DIR=
STORAGE_SIGNING_SECRET=
CLOUDFRONT_KEY_PAIR_ID=
CLOUDFRONT_PRIVATE_KEY=

WATCHLIST_LIMIT_FREE=
API_PUBLIC_URL=
WEB_ORIGIN=
# Early-beta admin CSV export for waitlist (Bearer / X-Admin-Token). api service only.
ADMIN_TOKEN=
# When false (default), waitlist confirmation email is a no-op stub.
WAITLIST_EMAIL_ENABLED=

EXPO_PUBLIC_API_URL=
# Public web origin for mobile share-card previews (`/api/og/...`). No secrets.
EXPO_PUBLIC_SITE_URL=
# Mobile Firebase web-app JSON string (apiKey, authDomain, projectId, appId, …). No secrets.
EXPO_PUBLIC_FIREBASE_CONFIG=
NEXT_PUBLIC_API_URL=
# Canonical public site origin (metadata / OG). Inlined at next build — set on web before build.
NEXT_PUBLIC_SITE_URL=
NEXT_PUBLIC_FIREBASE_CONFIG=

# Observability (T9.1). Leave unset for local no-op. Never commit real values.
SENTRY_DSN=
# Browser / Expo public DSN mirrors (inlined at build). Prefer project-scoped DSNs.
NEXT_PUBLIC_SENTRY_DSN=
EXPO_PUBLIC_SENTRY_DSN=
POSTHOG_KEY=
POSTHOG_HOST=
# PostHog browser / Expo keys (EU host default https://eu.i.posthog.com when HOST unset).
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=
EXPO_PUBLIC_POSTHOG_KEY=
EXPO_PUBLIC_POSTHOG_HOST=
